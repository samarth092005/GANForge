# ========================================================
# GANForge Environment Configuration
# ========================================================

# Gemini API Configuration for AI Auto-Report Generation (Unit U2)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API Configuration (Legacy/Fallback)
# Obtain your free API key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model (openai/gpt-oss-20b or llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=openai/gpt-oss-20b

# Training & Application Defaults
RANDOM_SEED=42
DEFAULT_BATCH_SIZE=32
DEFAULT_LATENT_DIM=100
DEFAULT_EPOCHS=50
IMAGE_SIZE=64
CHANNELS=3
